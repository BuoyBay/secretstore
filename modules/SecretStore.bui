Import keychain
Import crypto

''' Operations belong to one worker; hold Acquire through load/update/save or delete.
Public Interface SecretRecordStorage
    Function Load() As String
    Sub Save(record As String)
    Sub Delete()
    Function Acquire() As Boolean
    Sub Release()
End Interface

''' Injectable item transport. Production uses only the platform's protected credential store.
Public Interface SecretRecordItems
    Function Read(account As String) As Optional Of String
    Sub Write(account As String, value As String)
    Sub Remove(account As String)
End Interface

Private Class NativeSecretRecordItems Implements SecretRecordItems
    Private Property Store As KeychainStore
    Public Sub Constructor(service As String)
        Me.Store = New KeychainStore(service)
    End Sub
    Public Function Read(account As String) As Optional Of String
        Return Me.Store.GetPassword(account)
    End Function
    Public Sub Write(account As String, value As String)
        Me.Store.SetPassword(account, value, "Buoy protected secret record")
    End Sub
    Public Sub Remove(account As String)
        Me.Store.DeletePassword(account)
    End Sub
End Class

#If TargetWindows Then
    Private Optional Declare Function CredentialOpen Lib "kernel32" Alias "CreateFileW" (name As Ptr, access As UInt32, sharing As UInt32, attributes As Ptr, disposition As UInt32, openFlags As UInt32, templateHandle As Ptr) As Ptr
    Private Optional Declare Function CredentialLock Lib "kernel32" Alias "LockFileEx" (handle As Ptr, openFlags As UInt32, reserved As UInt32, lowBytes As UInt32, highBytes As UInt32, overlapped As Ptr) As Int32
    Private Optional Declare Function CredentialInfo Lib "kernel32" Alias "GetFileInformationByHandleEx" (handle As Ptr, infoClass As Int32, info As Ptr, size As UInt32) As Int32
    Private Optional Declare Function CredentialClose Lib "kernel32" Alias "CloseHandle" (handle As Ptr) As Int32
    Private Optional Declare Function CredentialLastError Lib "kernel32" Alias "GetLastError" () As UInt32
#Else
    Private Declare Function CredentialOpen Lib "c" Alias "open" (filePath As String, openFlags As Int32, ...) As Int32
    #If TargetMac Then
        Private Delegate Function CredentialLockFunction(descriptor As Int32, operation As Int32) As Int32
        Private Declare Function CredentialSymbol Lib "c" Alias "dlsym" (library As Ptr, symbol As String) As Ptr
        Private Function CredentialLock(descriptor As Int32, operation As Int32) As Int32
            ' Buoy's bundled libc link stub omits flock. Resolve the real system symbol.
            Dim symbol As Ptr = CredentialSymbol(CType(-2, Ptr), "flock")
            If symbol = Nil Then Throw New InvalidArgumentException("Native secret-record locking is unavailable")
            Dim locker As CredentialLockFunction = CType(symbol, CredentialLockFunction)
            Return locker(descriptor, operation)
        End Function
    #Else
        Private Optional Declare Function CredentialLock Lib "c" Alias "flock" (descriptor As Int32, operation As Int32) As Int32
    #End If
    Private Declare Function CredentialClose Lib "c" Alias "close" (descriptor As Int32) As Int32
#End If

Private Function CredentialGenerationValid(value As String) As Boolean
    If String.Len(value) <> 22 Then Return False
    For Each character As String In String.Chars(value)
        If Not String.Contains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", character, True) Then Return False
    Next
    Return True
End Function

Private Function CredentialCount(value As JSONItem) As Integer
    If Not value.IsNumber() Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    Dim number As Double = value.AsNumber().Or(0.0)
    If number < 1.0 Or number > 1024.0 Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    Dim count As Integer = number
    If count <> number Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    Return count
End Function

Private Function CredentialManifest(text As String) As JSONItem
    If String.LenBytes(text) > 1024 Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    Dim parsed As Optional Of JSONItem = Json.TryParse(text)
    If Not parsed.HasValue Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    Dim value As JSONItem = parsed.Value
    If Not value.IsObject() Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    If CredentialCount(value.Value("version")) <> 1 Then Throw New InvalidArgumentException("Saved secret record format is unsupported")
    If Not CredentialGenerationValid(value.Value("generation").AsString().Or("")) Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    Dim count As Integer = CredentialCount(value.Value("count"))
    If count < 1 Or count > 1024 Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    If String.Len(value.Value("digest").AsString().Or("")) <> 44 Then Throw New InvalidArgumentException("Saved secret record metadata is invalid")
    Return value
End Function

Private Function CredentialDecode(encoded As String, expectedDigest As String) As String
    Dim decoded As Result Of Bytes, String = Bytes.FromBase64(encoded)
    If decoded.IsErr Then Throw New InvalidArgumentException("Saved secret record encoding is invalid")
    If decoded.Value.Count < 1 Or decoded.Value.Count > 1048576 Then Throw New InvalidArgumentException("Saved secret record size is invalid")
    If decoded.Value.ToBase64() <> encoded Then Throw New InvalidArgumentException("Saved secret record encoding is invalid")
    Dim digest As String = Crypto.Hash(Crypto.HashAlgorithms.SHA256, decoded.Value).ToBase64()
    If digest <> expectedDigest Then Throw New InvalidArgumentException("Saved secret record is incomplete; save the record again")
    Return decoded.Value.ToString(Text.Encodings.UTF8)
End Function

''' Stable across builds. Only small ASCII pieces go into native credential items; the
''' manifest switches generations after every piece is written. A failed save leaves
''' the previous committed record readable. Lock files contain no credential material.
Public Class SecretRecordStore Implements SecretRecordStorage
    Private Property Account As String
    Private Property LockIdentity As String
    Private Property Items As SecretRecordItems
    Private Property Locked As Boolean = False
    Private Property SingleItem As Boolean = False
    ' Only migration metadata is cached, and only while holding the operation lock.
    Private Property PreviousKnown As Boolean = False
    Private Property PreviousManifest As JSONItem
    #If TargetWindows Then
        Private Property LockHandle As Ptr
    #Else
        Private Property LockDescriptor As Int32 = -1
    #End If

    Public Sub Constructor(service As String, account As String)
        Me.Configure(service, account, New NativeSecretRecordItems(service))
        #If TargetMac Then
            Me.SingleItem = True
        #End If
    End Sub

    ''' Fixtures supply an in-memory item backend; locking remains native.
    Public Sub Constructor(service As String, account As String, items As SecretRecordItems, singleItem As Boolean = False)
        Me.Configure(service, account, items)
        Me.SingleItem = singleItem
    End Sub

    Private Sub Configure(service As String, account As String, items As SecretRecordItems)
        If String.Trim(service) = "" Or service.AsUTF16LE().Count > 256 Or items = Nil Then Throw New InvalidArgumentException("Invalid secret storage service")
        If account = "" Or account.AsUTF16LE().Count > 800 Then Throw New InvalidArgumentException("Invalid secret storage account")
        If String.Contains(service, "/", True) Or String.Contains(service, "\\", True) Then Throw New InvalidArgumentException("Secret storage service cannot contain path separators")
        For Each character As String In String.Chars(service + account)
            If String.Asc(character) = 0 Then Throw New InvalidArgumentException("Secret storage identities cannot contain NUL")
        Next
        Me.Account = account
        Me.Items = items
        Dim lockService As String = service
        Dim lockAccount As String = account
        #If TargetWindows Then
            ' Credential Manager compares target names case-insensitively.
            lockService = String.LCase(lockService)
            lockAccount = String.LCase(lockAccount)
        #End If
        Dim identity As Bytes = Bytes.FromString(lockService, Text.Encodings.UTF8)
        identity.Append(0)
        Dim accountBytes As Bytes = Bytes.FromString(lockAccount, Text.Encodings.UTF8)
        identity.Append(accountBytes.DataPtr(), accountBytes.Count)
        Me.LockIdentity = Crypto.Hash(Crypto.HashAlgorithms.SHA256, identity).ToBase64()
        Me.LockIdentity = String.Replace(String.Replace(String.Replace(Me.LockIdentity, "+", "-", True), "/", "_", True), "=", "", True)
    End Sub

    Public Function Acquire() As Boolean
        If Me.Locked Then Throw New InvalidArgumentException("Secret-record storage is already locked")
        #If TargetWindows Then
            Dim homePath As String = System.EnvironmentVariable("USERPROFILE").Or("")
            If homePath = "" Then Throw New InvalidArgumentException("User profile is unavailable for secret-record locking")
            Dim widePath As Bytes = Bytes.FromString(homePath + "\\.buoy-secretstore-" + Me.LockIdentity + ".lock", Text.Encodings.UTF16LE)
            widePath.Append(0)
            widePath.Append(0)
            Me.LockHandle = CredentialOpen(widePath.DataPtr(), 3221225472, 3, Nil, 4, 2097280, Nil)
            If Me.LockHandle = Nil Or CType(Me.LockHandle, Integer) = -1 Then
                Me.LockHandle = Nil
                Throw New InvalidArgumentException("Could not open secret-record storage lock")
            End If
            Dim info As New Bytes()
            For i As Integer = 0 To 7
                info.Append(0)
            Next
            If CredentialInfo(Me.LockHandle, 9, info.DataPtr(), 8) = 0 Or (info.Item(1) And 4) <> 0 Then
                CredentialClose(Me.LockHandle)
                Me.LockHandle = Nil
                Throw New InvalidArgumentException("Unsafe secret-record storage lock")
            End If
            Dim overlap As New Bytes()
            For i As Integer = 0 To 31
                overlap.Append(0)
            Next
            If CredentialLock(Me.LockHandle, 3, 0, 1, 0, overlap.DataPtr()) = 0 Then
                Dim nativeError As UInt32 = CredentialLastError()
                CredentialClose(Me.LockHandle)
                Me.LockHandle = Nil
                If nativeError = 33 Then Return False
                Throw New InvalidArgumentException("Could not acquire secret-record storage lock")
            End If
        #Else
            Dim homePath As String = System.EnvironmentVariable("HOME").Or("")
            If homePath = "" Then Throw New InvalidArgumentException("Home directory is unavailable for secret-record locking")
            #If TargetMac Then
                ' O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC.
                Dim openFlags As Int32 = 16777986
            #Else
                Dim openFlags As Int32 = 655426
            #End If
            Me.LockDescriptor = CredentialOpen(homePath + "/.buoy-secretstore-" + Me.LockIdentity + ".lock", openFlags, 384)
            If Me.LockDescriptor < 0 Then Throw New InvalidArgumentException("Could not open secret-record storage lock")
            Dim acquired As Int32
            Try
                acquired = CredentialLock(Me.LockDescriptor, 6)
            Catch e As Exception
                CredentialClose(Me.LockDescriptor)
                Me.LockDescriptor = -1
                Throw e
            End Try
            If acquired <> 0 Then
                CredentialClose(Me.LockDescriptor)
                Me.LockDescriptor = -1
                Return False
            End If
        #End If
        Me.Locked = True
        Return True
    End Function

    Public Sub Release()
        If Not Me.Locked Then Return
        Me.PreviousKnown = False
        Me.PreviousManifest = Nil
        #If TargetWindows Then
            CredentialClose(Me.LockHandle)
            Me.LockHandle = Nil
        #Else
            CredentialClose(Me.LockDescriptor)
            Me.LockDescriptor = -1
        #End If
        Me.Locked = False
    End Sub

    Private Sub RequireLock()
        If Not Me.Locked Then Throw New InvalidArgumentException("Acquire secret-record storage before accessing it")
    End Sub

    Private Function PieceAccount(generation As String, index As Integer) As String
        Return Me.Account + "." + generation + "." + String.From(index)
    End Function

    Private Sub RemoveGeneration(manifest As JSONItem)
        If manifest = Nil Then Return
        Dim generation As String = manifest.Value("generation").AsString().Or("")
        Dim count As Integer = CredentialCount(manifest.Value("count"))
        For i As Integer = 0 To count - 1
            Me.Items.Remove(Me.PieceAccount(generation, i))
        Next
    End Sub

    Public Function Load() As String
        Me.RequireLock()
        Me.PreviousKnown = False
        Me.PreviousManifest = Nil
        Dim saved As Optional Of String = Me.Items.Read(Me.Account)
        If Not saved.HasValue Then
            Me.PreviousKnown = True
            Return ""
        End If
        ' Version 2 stores the complete record in one protected item on macOS.
        ' Keep version 1 readable so an existing session migrates on its next save.
        Dim parsed As Optional Of JSONItem = Json.TryParse(saved.Value)
        If parsed.HasValue Then
            If parsed.Value.IsObject() And parsed.Value.Value("version").AsNumber().Or(0.0) = 2.0 Then
                Dim encoded As String = parsed.Value.Value("record").AsString().Or("")
                If String.LenBytes(encoded) > 1398104 Then Throw New InvalidArgumentException("Saved secret record is too large")
                Dim record As String = CredentialDecode(encoded, parsed.Value.Value("digest").AsString().Or(""))
                Me.PreviousKnown = True
                Return record
            End If
        End If
        Dim manifest As JSONItem = CredentialManifest(saved.Value)
        Me.PreviousManifest = manifest
        Me.PreviousKnown = True
        If manifest.Value("deleted").AsBoolean().Or(False) Then Return ""
        Dim encoded As String = ""
        Dim count As Integer = CredentialCount(manifest.Value("count"))
        Dim generation As String = manifest.Value("generation").AsString().Or("")
        For i As Integer = 0 To count - 1
            Dim piece As Optional Of String = Me.Items.Read(Me.PieceAccount(generation, i))
            If Not piece.HasValue Then Throw New InvalidArgumentException("Saved secret record is incomplete; save the record again")
            If String.LenBytes(piece.Value) > 1800 Then Throw New InvalidArgumentException("Saved secret record piece is invalid")
            encoded += piece.Value
        Next
        Return CredentialDecode(encoded, manifest.Value("digest").AsString().Or(""))
    End Function

    Public Sub Save(record As String)
        Me.RequireLock()
        Dim data As Bytes = Bytes.FromString(record, Text.Encodings.UTF8)
        If data.Count < 1 Or data.Count > 1048576 Then Throw New InvalidArgumentException("Secret-record record is too large or empty")
        Dim previous As JSONItem = Nil
        If Me.SingleItem And Me.PreviousKnown Then
            previous = Me.PreviousManifest
        Else
            Dim old As Optional Of String = Me.Items.Read(Me.Account)
            If old.HasValue Then
                Try
                    previous = CredentialManifest(old.Value)
                Catch malformed As InvalidArgumentException
                    ' A fresh secret record can replace unusable metadata.
                End Try
            End If
        End If
        If Me.SingleItem Then
            Dim compact As JSONItem = JSONItem.NewObject()
            compact.Value("version") = 2
            compact.Value("record") = data.ToBase64()
            compact.Value("digest") = Crypto.Hash(Crypto.HashAlgorithms.SHA256, data).ToBase64()
            ' Replace the existing item atomically, preserving its native access policy.
            ' A failed write leaves the previous compact record or manifest intact.
            Me.Items.Write(Me.Account, compact.ToString())
            Me.PreviousKnown = True
            Me.PreviousManifest = Nil
            Try
                Me.RemoveGeneration(previous)
            Catch cleanup As Exception
            End Try
            Return
        End If
        Dim generation As String = Crypto.RandomBytes(16).ToBase64()
        generation = String.Replace(String.Replace(String.Replace(generation, "+", "-", True), "/", "_", True), "=", "", True)
        Dim encoded As String = data.ToBase64()
        Dim count As Integer = (String.Len(encoded) + 1799) \ 1800
        Dim manifest As JSONItem = JSONItem.NewObject()
        manifest.Value("version") = 1
        manifest.Value("generation") = generation
        manifest.Value("count") = count
        manifest.Value("digest") = Crypto.Hash(Crypto.HashAlgorithms.SHA256, data).ToBase64()
        Try
            For i As Integer = 0 To count - 1
                Me.Items.Write(Me.PieceAccount(generation, i), String.Substring(encoded, i * 1800, Math.Min(1800, String.Len(encoded) - i * 1800)))
            Next
            Me.Items.Write(Me.Account, manifest.ToString())
        Catch e As Exception
            ' The previous manifest is untouched. Best effort removes uncommitted pieces.
            Try
                Me.RemoveGeneration(manifest)
            Catch cleanup As Exception
            End Try
            Throw e
        End Try
        ' Committed replacement must not be reported as failed because stale cleanup failed.
        Try
            Me.RemoveGeneration(previous)
        Catch cleanup As Exception
        End Try
    End Sub

    Public Sub Delete()
        Me.RequireLock()
        Me.PreviousKnown = False
        Me.PreviousManifest = Nil
        Dim saved As Optional Of String = Me.Items.Read(Me.Account)
        If Not saved.HasValue Then Return
        Dim manifest As JSONItem = Nil
        Try
            manifest = CredentialManifest(saved.Value)
        Catch malformed As InvalidArgumentException
            ' Invalid metadata must not prevent removing the restore pointer.
        End Try
        ' Commit a tombstone first: interrupted cleanup cannot restore the session,
        ' and a later Delete can still locate and remove the remaining pieces.
        If manifest <> Nil Then
            manifest.Value("deleted") = True
            Me.Items.Write(Me.Account, manifest.ToString())
            Me.RemoveGeneration(manifest)
        End If
        Me.Items.Remove(Me.Account)
    End Sub

    Public Sub Destructor()
        Me.Release()
    End Sub
End Class
